{
  "name": "hireincapetown",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist/server && node --env-file-if-exists=.env scripts/prerender.mjs",
    "preview": "vite preview --outDir dist/client",
    "db:push": "psql \"$DATABASE_URL\" -f db/migrations/0001_init.sql",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "test": "node --test test/*.test.js",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
