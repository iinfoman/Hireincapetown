# Neon connection string. Without it the build falls back to db/seed.json,
# which is how the site builds before the database exists.
DATABASE_URL=

# Cloudflare R2 — verification documents. Server-side only, never exposed.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hireincapetown-verification

SITE_URL=https://hireincapetown.co.za
