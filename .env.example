# Supabase — the SolarinstallersSA project, shared. HireInCapeTown lives in the
# `hireincapetown` schema; Solar owns `public`. Never run unqualified DDL here.
#
# Connection string: Supabase dashboard → Project Settings → Database →
# Connection string → URI. Use the pooled (port 6543) one for builds.
# Without it the build falls back to db/seed.json.
DATABASE_URL=

# Supabase project, for the authenticated flows when they arrive.
SUPABASE_URL=https://alogcohoopgzerrxheiw.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Reads verification documents. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

SITE_URL=https://hireincapetown.co.za
